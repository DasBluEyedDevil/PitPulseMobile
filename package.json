{
  "name": "soundcheck-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SoundCheck monorepo - delegates to backend for Railway deployment",
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "preinstall": "echo 'Installing from backend directory...'",
    "install": "npm ci --prefix backend",
    "install:backend": "npm ci --prefix backend",
    "install:web": "npm ci --prefix web",
    "build": "npm run build --prefix backend",
    "build:web": "npm run build --prefix web",
    "start": "npm start --prefix backend",
    "dev": "npm run dev --prefix backend",
    "dev:web": "npm run dev --prefix web",
    "preview:web": "npm run preview --prefix web",
    "test": "npm test --prefix backend",
    "harness:check": "node scripts/check-agent-harness.mjs",
    "check:backend": "npm run lint --prefix backend && npm run typecheck --prefix backend && npm test --prefix backend",
    "check:mobile": "cd mobile && flutter pub run build_runner build --delete-conflicting-outputs && flutter analyze && flutter test",
    "check:web": "npm run build --prefix web",
    "check": "npm run harness:check && npm run check:backend && npm run check:web && npm run check:mobile",
    "fastlane:check": "node scripts/check-fastlane-store-assets.mjs",
    "fastlane:android:screenshots": "node scripts/run-fastlane.mjs android screenshots",
    "fastlane:android:capture-screenshots": "node scripts/run-fastlane.mjs android capture_store_screenshots",
    "fastlane:android:beta": "node scripts/run-fastlane.mjs android beta",
    "fastlane:ios:screenshots": "node scripts/run-fastlane.mjs ios screenshots",
    "fastlane:ios:capture-screenshots": "node scripts/run-fastlane.mjs ios capture_store_screenshots",
    "fastlane:ios:beta": "node scripts/run-fastlane.mjs ios beta",
    "prepare": "node .husky/install.mjs"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "prettier --write --config backend/.prettierrc",
      "eslint --fix --max-warnings 0"
    ],
    "mobile/**/*.dart": [
      "dart format"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3"
  }
}
