{
  "schemaVersion": 1,
  "description": "Executable classification contract for the current Express HTTP surface. The earlier audit's 160-row artifact was not versioned; this contract derives the current equivalent directly from TypeScript and fingerprints all 156 active endpoints.",
  "allowedClassifications": [
    "mobile-used",
    "operational/admin",
    "public",
    "deliberately removed"
  ],
  "semantics": {
    "canonicalErrors": "API failures use { success: false, error: { code, message, details? } }; mobile retains legacy string parsing during rollout.",
    "statusEvidence": "Status behavior remains owned by the route handler/controller and the global error middleware; the validator reports the exact handler and source line for every row.",
    "requestModelEvidence": "Route Zod schema names are extracted when present. Inline schema parsing and handler-defined input are reported explicitly rather than claimed as route validation.",
    "responseModelEvidence": "API handlers return ApiResponse/domain DTOs; public landing handlers return HTML and authenticated upload handlers return binary content.",
    "effectsEvidence": "The extracted final handler identifies the controller/service boundary that owns persistence, queues, realtime, push, webhooks, or rendering effects."
  },
