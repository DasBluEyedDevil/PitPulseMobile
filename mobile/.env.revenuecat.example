# Copy to .env.revenuecat and fill local RevenueCat values. Do not commit .env.revenuecat.
#
# Test Store key for debug/profile builds only. Never use this for App Store
# or Play Store submission.
RC_TEST_KEY=REPLACE_ME

# Platform-specific public SDK keys for real store builds.
RC_GOOGLE_KEY=REPLACE_ME
RC_APPLE_KEY=REPLACE_ME
