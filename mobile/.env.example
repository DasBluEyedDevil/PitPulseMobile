# Backend API Configuration
API_BASE_URL=http://localhost:3000/api

# For Android Emulator, use:
# API_BASE_URL=http://10.0.2.2:3000/api

# For iOS Simulator, use:
# API_BASE_URL=http://localhost:3000/api

# For Physical Device, use your computer's IP:
# API_BASE_URL=http://192.168.1.100:3000/api

# Optional: Error tracking with Sentry
# SENTRY_DSN=your-sentry-dsn

# Firebase client API keys
# These are supplied to Flutter with --dart-define; this file is only a
# template and is not loaded automatically by the app.
FIREBASE_ANDROID_API_KEY=replace-with-android-firebase-api-key
FIREBASE_IOS_API_KEY=replace-with-ios-firebase-api-key
