# Copy this file to .env and fill in local values. Do not commit .env.
SUPPLY_JSON_KEY_FILE=fastlane/play-store-service-account-revenuecat-soundcheck.json
# SUPPLY_JSON_KEY_DATA can be used in CI instead of a file path.
# SUPPLY_JSON_KEY_DATA=
SUPPLY_TRACK=internal
SOUNDCHECK_FLUTTER_BUILD_ARGS=--dart-define-from-file=.env.firebase --dart-define-from-file=.env.revenuecat --dart-define=SENTRY_DSN=REPLACE_ME
