{
  "name": "soundcheck-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:legal": "node scripts/sync-legal.mjs",
    "sync:brand": "node scripts/sync-brand.mjs",
    "predev": "npm run sync:legal && npm run sync:brand",
    "dev": "astro dev --host 127.0.0.1",
