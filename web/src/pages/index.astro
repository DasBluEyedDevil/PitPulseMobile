---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ShowPosterCard from '../components/ShowPosterCard.astro';
import GlassPanel from '../components/GlassPanel.astro';
import StoreButtons from '../components/StoreButtons.astro';
import NeonButton from '../components/NeonButton.astro';

const posters = [
  { image: '/brand/show-card-1.jpg', title: 'Neon Nights', subtitle: 'Brooklyn, NY', accent: 'cyan' as const },
  { image: '/brand/show-card-2.jpg', title: 'Electric Pulse', subtitle: 'Austin, TX', accent: 'magenta' as const },
  { image: '/brand/show-card-3.jpg', title: 'Violet Hour', subtitle: 'Seattle, WA', accent: 'violet' as const },
];
---

<BaseLayout>
  <Hero />
  <FeatureGrid />

  <section class="border-y border-cyan/5 bg-surface/30 py-16">
    <div class="mx-auto max-w-container px-5 md:px-8">
      <h2 class="font-display text-2xl font-bold text-chrome md:text-3xl">Shows happening now</h2>
      <p class="mt-2 font-body text-muted">Discover what fans are checking into tonight.</p>
      <div class="mt-8 flex gap-4 overflow-x-auto pb-4">
        {posters.map((p) => <ShowPosterCard {...p} />)}
      </div>
      </div>
  </section>

  <section class="mx-auto max-w-container px-5 py-20 md:px-8 md:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <GlassPanel>
        <p class="font-display text-sm font-bold uppercase tracking-wide text-magenta">Your concert history</p>
        <h2 class="mt-3 font-display text-3xl font-black text-chrome">See your year in live music</h2>
        <p class="mt-4 font-body text-silver">
          Review your top venues, most-seen bands, and badge milestones from every show you logged — then
          share your stats with friends who were there.
        </p>
        <NeonButton href="/download" class="mt-8">Get SoundCheck</NeonButton>
      </GlassPanel>
      <div class="relative overflow-hidden rounded-2xl border border-cyan/10">
        <img
          src="/brand/profile-wave.jpg"
          alt="SoundCheck profile and activity preview"
          class="w-full object-cover"
          loading="lazy"
          width="640"
          height="480"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-void/80 to-transparent" />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-container px-5 pb-24 md:px-8">
    <GlassPanel class="text-center">
      <h2 class="font-display text-2xl font-black text-chrome md:text-3xl">Ready for the next show?</h2>
      <p class="mx-auto mt-3 max-w-lg font-body text-silver">
        Download SoundCheck and start building your live music resume today.
      </p>
      <StoreButtons size="large" class="mt-8 justify-center" />
    </GlassPanel>
  </section>
</BaseLayout>
