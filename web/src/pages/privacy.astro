---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPanel from '../components/GlassPanel.astro';

const entry = await getEntry('legal', 'privacy');
if (!entry) throw new Error('Privacy policy not found. Run npm run sync:legal');
const { Content } = await render(entry);
---

<BaseLayout title="Privacy Policy" description="SoundCheck privacy policy — how we collect, use, and protect your data.">
  <article class="mx-auto max-w-container px-5 py-12 md:px-8 md:py-16">
    <GlassPanel>
      <div class="prose-legal">
        <Content />
      </div>
    </GlassPanel>
  </article>
</BaseLayout>
