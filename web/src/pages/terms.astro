---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPanel from '../components/GlassPanel.astro';

const entry = await getEntry('legal', 'terms');
if (!entry) throw new Error('Terms of service not found. Run npm run sync:legal');
const { Content } = await entry.render();
---

<BaseLayout title="Terms of Service" description="SoundCheck terms of service and user agreement.">
  <article class="mx-auto max-w-container px-5 py-12 md:px-8 md:py-16">
    <GlassPanel>
      <div class="prose-legal">
        <Content />
      </div>
    </GlassPanel>
  </article>
</BaseLayout>
