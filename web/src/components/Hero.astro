---
import EqualizerDivider from './EqualizerDivider.astro';
import StoreButtons from './StoreButtons.astro';
---

<section class="relative min-h-[85vh] overflow-hidden">
  <img
    src="/brand/hero-stage.jpg"
    alt=""
    class="absolute inset-0 h-full w-full object-cover opacity-50"
    fetchpriority="high"
  />
  <div class="hero-scrim absolute inset-0" />
  <div class="relative mx-auto flex max-w-container flex-col items-center px-5 pb-20 pt-24 text-center md:px-8 md:pt-32">
    <img
      src="/brand/mark.png"
      alt=""
      class="mb-6 h-20 w-20 drop-shadow-neon"
      width="80"
      height="80"
    />
    <h1 class="max-w-3xl font-display text-4xl font-black leading-tight text-chrome md:text-5xl lg:text-6xl">
      Live music. <span class="gradient-text">Real connection.</span>
    </h1>
    <p class="mt-6 max-w-xl font-body text-lg text-silver md:text-xl">
      Check in. Share the moment. Relive every beat.
    </p>
    <EqualizerDivider class="mt-8" />
    <StoreButtons size="large" class="mt-10 justify-center" />
  </div>
</section>
