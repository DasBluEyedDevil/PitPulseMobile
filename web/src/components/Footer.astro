---
const footerLinks = [
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
  { href: '/support', label: 'Support' },
  { href: '/delete-account', label: 'Delete Account' },
  { href: '/child-safety', label: 'Child Safety' },
  { href: '/download', label: 'Download' },
];
---

<footer class="border-t border-cyan/10 bg-void/80 py-12">
  <div class="mx-auto max-w-container px-5 md:px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div>
        <a href="/" class="inline-block">
          <img
            src="/brand/wordmark.png"
            alt="SoundCheck"
            class="h-9 w-auto object-contain"
            height="36"
          />
        </a>
        <p class="mt-3 max-w-sm font-body text-sm text-muted">
          Live music. Real connection. The social app for concert check-ins, ratings, and your live
          music resume.
        </p>
        <p class="mt-4 font-body text-sm text-muted">
          <a href="mailto:support@soundcheck.app" class="text-cyan hover:underline"
            >support@soundcheck.app</a
          >
        </p>
      </div>

      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
        {
          footerLinks.map((link) => (
            <a
              href={link.href}
              class="font-body text-sm text-silver transition-colors hover:text-cyan"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <p class="mt-10 border-t border-stroke-glass/30 pt-6 font-body text-xs text-muted">
      &copy; 2026 9th Level Software LLC. All rights reserved.
    </p>
  </div>
</footer>
