---
interface Props {
  name: 'ticket' | 'resume' | 'discover';
}

const { name } = Astro.props;
---

<span class="inline-flex h-10 w-10 shrink-0 items-center justify-center text-cyan" aria-hidden="true">
  {
    name === 'ticket' && (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-8 w-8">
        <path d="M22 10.5V8a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2.5a3.5 3.5 0 0 1 0 7V16a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-1.5a3.5 3.5 0 0 1 0-7ZM9 16H7v-2h2v2Zm0-4H7v-2h2v2Zm4 4h-2v-2h2v2Zm0-4h-2v-2h2v2Zm4 4h-2v-2h2v2Zm0-4h-2v-2h2v2Z" />
      </svg>
    )
  }
  {
    name === 'resume' && (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-8 w-8">
        <path d="M4 18h2V6H4v12Zm4 0h2V10H8v8Zm4 0h2V4h-2v14Zm4 0h2V14h-2v4Z" />
      </svg>
    )
  }
  {
    name === 'discover' && (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-8 w-8">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z" />
      </svg>
    )
  }
</span>
