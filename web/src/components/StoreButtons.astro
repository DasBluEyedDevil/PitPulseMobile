---
interface Props {
  size?: 'default' | 'large';
  class?: string;
}

const { size = 'default', class: className = '' } = Astro.props;

const playUrl = 'https://play.google.com/store/apps/details?id=com.soundcheck.app';
const appStoreUrl = 'https://apps.apple.com/app/soundcheck/id000000000';

// Normalized PNGs from scripts/optimize-store-badges.mjs (same 48px source height).
const badgeClass = size === 'large' ? 'h-12 w-auto' : 'h-10 w-auto';
---

<div class={`flex flex-wrap items-center gap-4 ${className}`}>
  <a href={playUrl} target="_blank" rel="noopener noreferrer" class="transition opacity-90 hover:opacity-100">
    <img
      src="/store/google-play.png"
      alt="Get it on Google Play"
      class={badgeClass}
      loading="lazy"
      decoding="async"
    />
  </a>
  <a href={appStoreUrl} target="_blank" rel="noopener noreferrer" class="transition opacity-90 hover:opacity-100">
    <img
      src="/store/app-store.png"
      alt="Download on the App Store"
      class={badgeClass}
      loading="lazy"
      decoding="async"
    />
  </a>
</div>
